# Owner string: local/CI only, NEVER on Vercel
DATABASE_URL_OWNER=
# app_user string, printed by `npm run db:setup-role`
DATABASE_URL=
# http://localhost:3000 locally, https://<app>.vercel.app in prod
APP_ORIGIN=http://localhost:3000
WEEKLY_OFF_DAYS=THU,FRI
# Days added to the Saudi (umalqura) Hijri date; Bangladesh usually sights the moon a day later
HIJRI_BD_DAY_OFFSET=1
